with
     "opencv_c";

library
project OpenCV
is
   for Create_Missing_Dirs use "True";

   for Languages       use ("ada");
   for Source_Dirs     use (".", "../source/**");
   for Object_Dir      use "build";
   for Library_Name    use "OpenCV";
   for Library_Dir     use "lib";
   for Library_Ali_Dir use "objects";

   package Builder is
      for Default_Switches ("ada") use ("-g", "-j0");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-gnat2022");
   end Compiler;

   package Linker is
      for Linker_Options use ("-lopencv_highgui", "-lopencv_imgcodecs", "-lopencv_imgproc", "-lopencv_core", "-lstdc++");
   end Linker;

end OpenCV;
